#!/bin/sh
# Vindex agent installer for Linux.
# Copyright (C) Viktrix Cyber Limited.
#
#   curl -fsSL <download host>/install.sh | sudo sh -s -- --code <install code>
#   sh install.sh --manager <host> --group <group> [--password <p>] [--name <agent name>]
#
# Installs the vindex-agent package for this machine (deb or rpm, x86_64 or arm64), which pulls in
# auditd and loads the Vindex audit rules, then enrols the agent and starts it.
# Generated by build-linux-packages.sh: the package checksums below are pinned at build time.

set -eu

BASE_URL="${VINDEX_DOWNLOAD_BASE:-@BASE_URL@}"
VERSION="@VERSION@"
SHA_DEB_AMD64="@SHA_DEB_AMD64@"
SHA_DEB_ARM64="@SHA_DEB_ARM64@"
SHA_RPM_X86_64="@SHA_RPM_X86_64@"
SHA_RPM_AARCH64="@SHA_RPM_AARCH64@"

die() { echo "vindex: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root: curl -fsSL ${BASE_URL}/install.sh | sudo sh -s -- --code <install code>"

ENROL_ARGS=""
CODE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --code)     CODE="${2:?--code needs a value}"; shift 2 ;;
        --manager|--group|--password|--name)
                    [ $# -ge 2 ] || die "$1 needs a value"
                    ENROL_ARGS="$ENROL_ARGS $1 $(printf '%s' "$2" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/")"
                    shift 2 ;;
        *)          die "unknown option $1" ;;
    esac
done
[ -n "$CODE" ] || [ -n "$ENROL_ARGS" ] || die "give --code <install code> from the Vindex console"

case "$(uname -m)" in
    x86_64|amd64)   DEB_ARCH=amd64; RPM_ARCH=x86_64 ;;
    aarch64|arm64)  DEB_ARCH=arm64; RPM_ARCH=aarch64 ;;
    *)              die "unsupported architecture $(uname -m)" ;;
esac

if command -v apt-get >/dev/null 2>&1; then
    PKG="vindex-agent_${VERSION}_${DEB_ARCH}.deb"
    [ "$DEB_ARCH" = amd64 ] && SHA="$SHA_DEB_AMD64" || SHA="$SHA_DEB_ARM64"
elif command -v dnf >/dev/null 2>&1 || command -v yum >/dev/null 2>&1 || command -v zypper >/dev/null 2>&1; then
    PKG="vindex-agent-${VERSION}.${RPM_ARCH}.rpm"
    [ "$RPM_ARCH" = x86_64 ] && SHA="$SHA_RPM_X86_64" || SHA="$SHA_RPM_AARCH64"
else
    die "no supported package manager (apt, dnf, yum or zypper)"
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
echo "vindex: downloading $PKG"
if command -v curl >/dev/null 2>&1; then
    curl -fsSL --proto '=https' -o "$TMP/$PKG" "$BASE_URL/$PKG"
else
    wget -q -O "$TMP/$PKG" "$BASE_URL/$PKG"
fi
echo "$SHA  $TMP/$PKG" | sha512sum -c - >/dev/null 2>&1 || die "checksum mismatch for $PKG; nothing was installed"

# Existing Wazuh agent: keep its enrolment (agent ID), configuration and enrolment password.
# deb: apt swaps the packages and the vindex-agent preinst restores them. rpm: wazuh-agent's own
# uninstall deletes /var/ossec/bin and the wazuh user, so back up, remove, install and restore.
MIGRATED=""
KEEP="client.keys ossec.conf authd.pass local_internal_options.conf"
if [ "${PKG##*.}" = rpm ] && rpm -q wazuh-agent >/dev/null 2>&1; then
    echo "vindex: replacing the existing Wazuh agent (its enrolment is kept)"
    mkdir -p "$TMP/keep"
    for f in $KEEP; do
        [ -f "/var/ossec/etc/$f" ] && cp -p "/var/ossec/etc/$f" "$TMP/keep/$f"
    done
    if command -v dnf >/dev/null 2>&1; then dnf remove -y wazuh-agent >/dev/null
    elif command -v yum >/dev/null 2>&1; then yum remove -y wazuh-agent >/dev/null
    else zypper --non-interactive remove wazuh-agent >/dev/null
    fi
    MIGRATED=rpm
elif [ "${PKG##*.}" = deb ] && dpkg -s wazuh-agent 2>/dev/null | grep -q "^Status: install ok installed"; then
    echo "vindex: replacing the existing Wazuh agent (its enrolment is kept)"
    MIGRATED=deb
fi

echo "vindex: installing $PKG"
case "$PKG" in
    *.deb) DEBIAN_FRONTEND=noninteractive apt-get install -y "$TMP/$PKG" >/dev/null ;;
    *.rpm)
        if command -v dnf >/dev/null 2>&1; then dnf install -y "$TMP/$PKG" >/dev/null
        elif command -v yum >/dev/null 2>&1; then yum install -y "$TMP/$PKG" >/dev/null
        else zypper --non-interactive install --allow-unsigned-rpm "$TMP/$PKG" >/dev/null
        fi ;;
esac

if [ "$MIGRATED" = rpm ]; then
    for f in $KEEP; do
        [ -f "$TMP/keep/$f" ] || continue
        cp -p "$TMP/keep/$f" "/var/ossec/etc/$f"
        chown root:wazuh "/var/ossec/etc/$f"
        chmod 0640 "/var/ossec/etc/$f"
    done
    /var/ossec/vindex/vindex-postinstall.sh configure >/dev/null || true
fi

if [ -n "$MIGRATED" ] && [ -s /var/ossec/etc/client.keys ]; then
    echo "vindex: kept the existing enrolment; no new install code was used"
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        systemctl daemon-reload; systemctl enable wazuh-agent >/dev/null 2>&1 || true; systemctl restart wazuh-agent
    else
        /var/ossec/bin/wazuh-control restart >/dev/null
    fi
else
    # ENROL_ARGS values are single-quoted above, so eval passes them through unchanged.
    eval "/usr/sbin/vindex-agent enrol ${CODE:+\"\$CODE\"} $ENROL_ARGS"
fi
/usr/sbin/vindex-agent status || true
